{
  "schemaVersion": 1,
  "id": "wynnoverhaul",
  "version": "${version}",
  "name": "WynnOverhaul",
  "description": "A client-side Wynncraft mod with a custom HUD, weapon animations, an entity tracker, a Content Book replacement and quality-of-life tools. Unofficial and not affiliated with Wynncraft.",
  "authors": [
    "Opal"
  ],
  "contact": {
    "homepage": "https://github.com/Opalinium/WynnOverhaul",
    "sources": "https://github.com/Opalinium/WynnOverhaul",
    "issues": "https://github.com/Opalinium/WynnOverhaul/issues"
  },
  "license": "LicenseRef-WynnOverhaul-Source-Available-NC",
  "environment": "client",
  "entrypoints": {
    "client": [
      "opal.dev.wynnoverhaul.client.WynnOverhaulClient",
      "opal.dev.wynnoverhaul.client.EntityTrackerClient",
      "opal.dev.wynnoverhaul.client.WynnQolClient",
      "opal.dev.wynnoverhaul.client.DiscordRichPresence",
      "opal.dev.wynnoverhaul.client.ContentBookInterceptor"
    ],
    "main": [
      "opal.dev.wynnoverhaul.WynnOverhaul"
    ],
    "modmenu": [
      "opal.dev.wynnoverhaul.client.WynnOverhaulModMenu"
    ]
  },
  "mixins": [
    {
      "config": "wynnoverhaul.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version_min}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "modmenu": "*",
    "voxy": "*"
  }
}
